# Copy this file to .env.local and fill in real values when you're ready to
# use the GitHub / Vercel / Context7 MCP servers (.mcp.json reads from these
# — nothing here is committed, and .mcp.json itself holds no literal secrets).

# Only needed when you're ready to push this repo to GitHub via the github MCP server.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Only needed when you're ready to deploy via the vercel MCP server.
VERCEL_API_TOKEN=

# Optional: raises rate limits for the context7 MCP server (Next.js/Tailwind/
# Framer Motion docs lookup during development). Get a free key at
# https://context7.com — the server still works without one.
CONTEXT7_API_KEY=
